              "pm.test(\"Status code es 201 Created\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "var responseData = pm.response.json();\r",
              "pm.collectionVariables.set(\"postId\", responseData.id);\r",
              "\r",
              "pm.test(\"El título del post es correcto\", function () {\r",
              "    pm.expect(responseData.title).to.eql(\"Prueba QA Automation\");\r",
              "});"
            ],
